<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/bg_vtx_glass_clock">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VTX  /  GLASS CLOCK"
        android:textColor="#718493"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.16"
        android:includeFontPadding="false" />

    <TextClock
        android:id="@+id/vtx_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-light"
        android:textColor="#263642"
        android:textSize="46sp"
        android:letterSpacing="-0.035"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <TextClock
        android:id="@+id/vtx_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:format12Hour="EEEE, d MMM"
        android:format24Hour="EEEE, d MMM"
        android:fontFamily="sans-serif-medium"
        android:textColor="#82919D"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:singleLine="true" />
</LinearLayout>
